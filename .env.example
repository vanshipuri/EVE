# Copy to .env and adjust. SQLite default needs zero setup.
DATABASE_URL=sqlite:///./eve.db
# For PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://eve:evepass@localhost:5432/eve

JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: require this header on POST /api/v1/payments/webhook/
# WEBHOOK_SECRET=whsec_local_123

# Optional: enables Redis caching (falls back to in-memory if unset)
# REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=dev
RATE_LIMIT_ENABLED=true
